<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>預排班・畫休</title>
<style>
  :root{
    --ink:#1f2430; --bg:#f5f6f8; --card:#ffffff; --line:#e4e7eb; --muted:#6b7280;
    --accent:#2f6f6a; --accent-d:#255a56;
    --off:#2f6f6a; --off-bg:#e8f3f2;
    --des:#15803d; --des-bg:#e7f4ea;
    --lv:#b45309; --lv-bg:#fdf3e3;
    --wknd:#c2410c; --wknd-bg:#fdf2ec;
    --over:#b91c1c; --over-bg:#fef2f2; --ok:#15803d; --ok-bg:#eef7f0;
  }
  *{box-sizing:border-box}
  html,body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang TC","Microsoft JhengHei",sans-serif;-webkit-text-size-adjust:100%}
  .wrap{max-width:600px;margin:0 auto;padding:0 12px 44px}
  header{position:sticky;top:0;z-index:5;background:var(--bg);padding:12px 0 6px}
  h1{font-size:18px;margin:0 0 2px;font-weight:700}
  .sub{font-size:12px;color:var(--muted)}
  .banner{display:none;margin:8px 0 0;padding:8px 10px;border-radius:8px;font-size:12.5px;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;line-height:1.4}
  .idrow{display:flex;gap:8px;align-items:center;margin-top:10px}
  .idrow label{font-size:13px;color:var(--muted);white-space:nowrap}
  select,input[type=number]{padding:9px 10px;border:1px solid var(--line);border-radius:9px;font-size:15px;background:var(--card)}
  #nameField{flex:1;min-width:0}
  .tabs{display:flex;gap:6px;margin-top:10px}
  .tab{flex:1;text-align:center;padding:9px 0;border:1px solid var(--line);background:var(--card);border-radius:10px;font-size:14px;color:var(--muted);cursor:pointer;user-select:none}
  .tab.on{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:600}
  .panel{display:none;margin-top:12px}.panel.on{display:block}

  /* 額度卡 */
  .qcard{margin-top:8px;background:var(--card);border:1px solid var(--line);border-radius:11px;padding:10px 12px}
  .qcard.overq{border-color:#f3b4b4;background:var(--over-bg)}
  .qtop{display:flex;justify-content:space-between;align-items:baseline}
  .qhead{font-size:15px;font-weight:700}
  .qtop .clr{font-size:12px;color:var(--accent);cursor:pointer;text-decoration:underline;white-space:nowrap}
  .qbar{height:8px;background:#eef1f4;border-radius:99px;margin:8px 0;overflow:hidden}
  .qfill{height:100%;width:0;background:var(--accent);border-radius:99px;transition:width .2s}
  .qfill.over{background:var(--over)}
  .qchips{display:flex;gap:6px;flex-wrap:wrap}
  .qchip{font-size:12px;background:#eef1f4;border-radius:7px;padding:3px 9px;color:#374151}
  .qchip.bad{background:var(--over-bg);color:var(--over);font-weight:700}

  .hint{font-size:12px;color:var(--muted);margin:0 2px 8px;line-height:1.5}
  .legend{display:flex;gap:10px;flex-wrap:wrap;font-size:11.5px;color:var(--muted);margin:2px 2px 8px}
  .legend span{display:inline-flex;align-items:center;gap:4px}
  .dot{width:11px;height:11px;border-radius:3px;display:inline-block}
  .dot.o{background:var(--off)}.dot.l{background:var(--des)}.dot.a{background:var(--lv)}.dot.w{background:var(--wknd)}

  .cal{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}
  .wk{font-size:11px;text-align:center;color:var(--muted);padding-bottom:2px}.wk.we{color:var(--wknd)}
  .cell{aspect-ratio:1/1.12;border:1px solid var(--line);border-radius:9px;background:var(--card);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;position:relative;user-select:none;transition:.1s}
  .cell.blank{border:none;background:transparent;cursor:default}
  .cell.ro{cursor:default}
  .cell .d{font-size:15px;font-weight:600}
  .cell .hol{font-size:9px;color:var(--wknd);margin-top:1px;line-height:1;text-align:center}
  .cell .lb{font-size:9px;margin-top:1px;line-height:1;font-weight:700}
  .cell .mk{position:absolute;top:3px;right:4px;font-size:9px;font-weight:800}
  .cell.we{background:var(--wknd-bg)}.cell.we .d{color:var(--wknd)}
  .cell.off{background:var(--off-bg);border-color:var(--off)}.cell.off .mk{color:var(--off)}
  .cell.des{background:var(--des-bg);border-color:var(--des)}.cell.des .mk{color:var(--des)}
  .cell.lv{background:var(--lv-bg);border-color:var(--lv)}.cell.lv .mk,.cell.lv .lb{color:var(--lv)}
  .cell.hol-on{background:var(--wknd-bg);border-color:var(--wknd)}
  .cell.ghost{opacity:.45}
  .cell:active:not(.blank):not(.ro){border-color:var(--accent)}

  .notes-h{font-size:13px;font-weight:700;margin:16px 2px 6px;color:var(--accent-d)}
  #noteField{width:100%;min-height:74px;padding:10px;border:1px solid var(--line);border-radius:10px;font-size:14px;font-family:inherit;resize:vertical;background:var(--card)}

  .warnbox{border-radius:11px;padding:11px 13px;font-size:13px;line-height:1.55;margin-bottom:8px}
  .warnbox.bad{background:var(--over-bg);border:1px solid #f3c0c0;color:#7f1d1d}
  .warnbox.warn{background:#fff7ed;border:1px solid #fed7aa;color:#9a3412}
  .warnbox.clear{background:var(--ok-bg);border:1px solid #bfe3c8;color:#14532d}
  .warnbox b{font-weight:700}
  .daycount{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin:6px 0 14px}
  .dc{border:1px solid var(--line);border-radius:8px;background:var(--card);padding:6px 0;text-align:center}
  .dc .dn{font-size:12px;color:var(--muted)}.dc .cn{font-size:15px;font-weight:700;margin-top:1px}
  .dc.hi{background:var(--over-bg);border-color:#f0b4b4}.dc.hi .cn{color:var(--over)}
  .dc.blank{border:none;background:transparent}
  .prow{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:9px 12px;margin-bottom:6px;font-size:13.5px}
  .prow .nn{font-weight:600}.prow .note{color:var(--muted);margin-top:3px;font-size:12.5px;white-space:pre-wrap}

  .exhd{font-size:13px;color:var(--muted);margin:2px 0 10px;line-height:1.5}
  .btnrow{display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap}
  .btn{flex:1;min-width:120px;padding:11px 0;border:none;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer}
  .btn.primary{background:var(--accent);color:#fff}.btn.ghost{background:var(--card);border:1px solid var(--line);color:var(--ink)}
  pre.out{background:#0f172a;color:#e2e8f0;border-radius:11px;padding:12px;font-size:11px;line-height:1.5;overflow:auto;max-height:360px;white-space:pre;margin:0;font-family:ui-monospace,Menlo,Consolas,monospace}
  .tablewrap{overflow:auto;-webkit-overflow-scrolling:touch;border:1px solid var(--line);border-radius:10px;max-height:62vh}
  .tablewrap table{border-collapse:collapse}

  .admbar{background:var(--card);border:1px solid var(--line);border-radius:11px;padding:12px;margin-bottom:12px}
  .admbar .r{display:flex;gap:8px;align-items:center;margin-bottom:9px;flex-wrap:wrap}
  .admbar label{font-size:13px;color:var(--muted);white-space:nowrap}
  .admbar input[type=number]{width:74px}.admbar select{flex:1;min-width:0}
  .admhint{font-size:12px;color:var(--muted);line-height:1.5;margin:0 0 6px}
  .admprog{font-size:12.5px;color:var(--accent-d);font-weight:600;margin:4px 2px 2px}
  .minibtn{padding:8px 12px;border:1px solid var(--line);background:var(--card);border-radius:9px;font-size:12.5px;cursor:pointer}

  /* 底部面板 */
  .sheet-bg{position:fixed;inset:0;background:rgba(15,23,42,.35);opacity:0;pointer-events:none;transition:.2s;z-index:30}
  .sheet-bg.show{opacity:1;pointer-events:auto}
  .sheet{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-radius:16px 16px 0 0;padding:14px 14px calc(18px + env(safe-area-inset-bottom));z-index:31;transform:translateY(110%);transition:.24s;box-shadow:0 -6px 24px rgba(0,0,0,.12);max-width:600px;margin:0 auto}
  .sheet.show{transform:translateY(0)}
  .sheet-h{font-size:15px;font-weight:700;margin-bottom:12px;text-align:center}
  .srow{display:flex;gap:8px;margin-bottom:8px}
  .sbtn{flex:1;padding:13px 4px;border:1px solid var(--line);background:var(--card);border-radius:10px;font-size:14px;font-weight:600;color:var(--ink);cursor:pointer}
  .sbtn.on{background:var(--accent);border-color:var(--accent);color:#fff}
  .sbtn.danger{color:var(--over);border-color:#f0c4c4}
  .sub2{font-size:12.5px;color:var(--muted);margin:10px 2px 6px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .step{display:inline-flex;align-items:center;gap:2px}
  .step b{display:inline-flex;width:30px;height:30px;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:8px;font-size:18px;cursor:pointer;background:var(--card)}
  .step i{min-width:34px;text-align:center;font-style:normal;font-weight:700;font-size:15px;color:var(--ink)}

  .toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%) translateY(20px);background:var(--ink);color:#fff;padding:10px 16px;border-radius:10px;font-size:13.5px;opacity:0;pointer-events:none;transition:.2s;z-index:40}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
  .foot{font-size:11px;color:#9aa2ad;text-align:center;margin-top:18px;line-height:1.6}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1 id="title">預排班・畫休</h1>
    <div class="sub" id="periodLabel">—</div>
    <div class="banner" id="banner"></div>
    <div class="idrow"><label>我是</label><select id="nameField"><option value="">請選擇姓名</option></select></div>
    <div class="qcard" id="quota">
      <div class="qtop"><span class="qhead" id="qHead">—</span><span class="clr" id="clearMine">清除</span></div>
      <div class="qbar"><div class="qfill" id="qFill"></div></div>
      <div class="qchips" id="qChips"></div>
    </div>
    <div class="tabs">
      <div class="tab on" data-tab="pick">畫休</div>
      <div class="tab" data-tab="board">總表</div>
      <div class="tab" data-tab="export">匯出</div>
      <div class="tab" data-tab="admin">管理</div>
    </div>
  </header>

  <section class="panel on" id="panel-pick">
    <div class="hint">點日期＝畫休（DO）。想改成<b>指定休</b>或<b>假別</b>，再點那天一次就會跳出選單。</div>
    <div class="legend">
      <span><i class="dot o"></i>DO</span><span><i class="dot l"></i>指定休</span>
      <span><i class="dot a"></i>假別</span><span><i class="dot w"></i>假日</span>
    </div>
    <div class="cal" id="cal"></div>
    <div class="notes-h">特殊需求（選填）</div>
    <textarea id="noteField" placeholder="如有特殊需求請寫在這裡，會顯示在管理端總表"></textarea>
  </section>

  <section class="panel" id="panel-board"></section>

  <section class="panel" id="panel-export">
    <div class="exhd">指定休＝<b style="color:#15803d">綠底 DO</b>、一般休 <b>DO</b>、假別 <b style="color:#b45309">A年8</b>；表格最下方有<b>休假人數</b>與<b>可排人力</b>。</div>
    <div class="btnrow"><button class="btn primary" id="btnXls">下載 Excel（含底色）</button><button class="btn ghost" id="btnCopy">複製純文字</button></div>
    <div class="tablewrap" id="exTable"></div>
  </section>

  <section class="panel" id="panel-admin">
    <div id="admLocked">
      <div class="exhd">此頁供每月的排班人員設定本期規則與國定假日。</div>
      <button class="btn primary" id="admUnlock" style="max-width:200px">解鎖管理</button>
    </div>
    <div id="admOpen" style="display:none">
      <div class="admbar">
        <div class="notes-h" style="margin-top:0">本期設定</div>
        <div class="r"><label>年</label><input id="cfgY" type="number"><label>月</label><input id="cfgM" type="number"></div>
        <div class="r"><label>可休總天數</label><input id="cfgQ" type="number"><label>指定休天數</label><input id="cfgD" type="number"></div>
        <div class="r"><label>可休假日上限</label><input id="cfgH" type="number"><span style="font-size:12px;color:var(--muted)">預設值，個別 4/5 可於下方調</span></div>
        <div class="admhint">改「年/月」會切換到該月的資料（每月獨立，換人接手直接用）。</div>
      </div>
      <div class="notes-h" style="margin-top:0">國定假日（點日期切換；週末已自動計為假日）</div>
      <div class="cal" id="holCal"></div>
      <div class="admbar" style="margin-top:12px">
        <div class="notes-h" style="margin-top:0">個別假日上限（4／5 例外）</div>
        <div class="r"><label>對象</label><select id="admName"></select><input id="admCap" type="number"></div>
        <div class="r"><button class="minibtn" id="admBulkCap">批次設定所有人</button><button class="minibtn" id="admLock">鎖定管理</button></div>
        <div class="admprog" id="admProg"></div>
      </div>
    </div>
  </section>

  <div class="foot" id="foot"></div>
</div>

<div class="sheet-bg" id="sheetBg"></div>
<div class="sheet" id="sheet"><div class="sheet-h" id="sheetDate">—</div><div id="sheetOpts"></div></div>
<div class="toast" id="toast"></div>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<script>
const CONFIG = {
  title: '正職預排班表',
  appRoot: 'main',
  offMark:'DO', desigMark:'指', leaveMark:'A',
  adminPassword: 'sched-admin',
  firebaseConfig: { apiKey:"AIzaSyDaht1PEsU-ckU8zSrO6nxGR9Vk6cJQZPo", authDomain:"paiban-5e685.firebaseapp.com", databaseURL:"https://paiban-5e685-default-rtdb.asia-southeast1.firebasedatabase.app", projectId:"paiban-5e685", storageBucket:"paiban-5e685.firebasestorage.app", messagingSenderId:"505893612516", appId:"1:505893612516:web:43fc2359005384b966f5f1" },
  defaults: { year:2026, month:10, quota:11, desigMax:3, holidayCap:5, holidays:{10:'國慶'} },
  // nolimit:true = 該員不受指定休 3 天上限（可指定更多天，仍受 11 天總額度）
  roster: [
    {zh:'吳秀真', en:'Amy'},    {zh:'洪郁凌', en:'LisaH'},  {zh:'謝庭湘', en:'Ronny'},
    {zh:'謝翔舟', en:'Poker'},  {zh:'張惠瑄', en:'Sherry', nolimit:true}, {zh:'葉庭漢', en:'Hank', nolimit:true},
    {zh:'陳佩琪', en:'Peggy'},  {zh:'盧詩怡', en:'Alice'},  {zh:'施維宣', en:'LisaS'},
    {zh:'蔡宜潔', en:'Jie'},    {zh:'謝岱凌', en:'Livi'},   {zh:'江瑋琳', en:'Doreen'},
    {zh:'張宮毓', en:'Miya'},   {zh:'陳孟嘉', en:'Stella'}, {zh:'侯美雪', en:'Vicky'},
    {zh:'曾佳慧', en:'Linda', nolimit:true},  {zh:'王怡茜', en:'Bella'},  {zh:'吳珮菁', en:'Nova'},
    {zh:'陳又慈', en:'Yoyo'},   {zh:'林玉英', en:'Ivy'},    {zh:'蘇惠君', en:'Elaine'},
    {zh:'蘇芳玉', en:'Ellen'},  {zh:'吳淑芬', en:'Rita'},   {zh:'吳淑敏', en:'Min'},
    {zh:'葉千華', en:'Ally'},   {zh:'楊紫棻', en:'Uie'},
  ]
};

const $ = id => document.getElementById(id);
const sanitize = s => (s||'').trim().replace(/[.#$/\[\]]/g,'_');
const WD = ['日','一','二','三','四','五','六'];
const LVNAME = {'年':'年假','補':'補休','喪':'喪假','他':'其他'};

let cfg = JSON.parse(JSON.stringify(CONFIG.defaults));
let off={}, desig={}, leave={}, notes={}, hcap={};
let me = localStorage.getItem('sched_zh') || '';
let adminName='', noteTimer=null, sheetDay=null, sheetHours=8;
let db=null, cloud=false, period='', dataRefs=[];

const dim = ()=> new Date(cfg.year, cfg.month, 0).getDate();
const firstDow = ()=> new Date(cfg.year, cfg.month-1, 1).getDay();
const isWeekend = d => { const w=new Date(cfg.year,cfg.month-1,d).getDay(); return w===0||w===6; };
const weekday = d => WD[new Date(cfg.year,cfg.month-1,d).getDay()];
const isHoliday = d => isWeekend(d) || !!(cfg.holidays&&cfg.holidays[d]);
const holLabel = d => { const h=cfg.holidays&&cfg.holidays[d]; return (typeof h==='string')?h:''; };
const isAdmin = ()=> sessionStorage.getItem('sched_admin')==='1';
const periodKey = ()=> cfg.year+'-'+cfg.month;

/* Firebase */
function initFirebase(){
  const c=CONFIG.firebaseConfig;
  if(!c||!c.databaseURL){ banner('未設定 Firebase，目前為單機預覽（不會同步給其他人）。'); renderAll(); return; }
  try{
    if(typeof firebase==='undefined') throw 0;
    firebase.initializeApp(c); db=firebase.database(); cloud=true;
    db.ref('schedule/'+CONFIG.appRoot+'/config').on('value',s=>{ const c2=s.val(); if(c2) applyCfg(c2); const np=periodKey(); if(np!==period){ period=np; subscribeData(period); } renderAll(); });
  }catch(e){ cloud=false; db=null; banner('雲端連線失敗，目前為單機預覽。部署後由手機開啟即可同步。'); renderAll(); }
}
function subscribeData(p){
  dataRefs.forEach(r=>r.off()); dataRefs=[];
  const base='schedule/'+CONFIG.appRoot+'/p/'+p+'/';
  const bind=(n,set)=>{ const r=db.ref(base+n); r.on('value',s=>{ set(s.val()||{}); renderAll(); }); dataRefs.push(r); };
  bind('off',v=>off=v); bind('desig',v=>desig=v); bind('leave',v=>leave=v); bind('notes',v=>notes=v); bind('hcap',v=>hcap=v);
}
const cloudReady=()=>cloud&&db;
const dref=path=>db.ref('schedule/'+CONFIG.appRoot+'/p/'+period+'/'+path);
const cref=path=>db.ref('schedule/'+CONFIG.appRoot+'/config/'+path);
function applyCfg(c){ ['year','month','quota','desigMax','holidayCap'].forEach(k=>{ if(c[k]!=null) cfg[k]=c[k]; }); if(c.holidays!=null) cfg.holidays=c.holidays||{}; }
function banner(t){ const b=$('banner'); b.textContent=t; b.style.display='block'; }

/* 資料 */
const myKey=()=>sanitize(me);
const offOf=k=>off[k]||{}, desOf=k=>desig[k]||{}, lvOf=k=>leave[k]||{};
const capOf=k=>(hcap[k]!=null)?hcap[k]:cfg.holidayCap;
function restSet(k){ const s=new Set(); Object.keys(desOf(k)).forEach(d=>s.add(+d)); Object.keys(offOf(k)).forEach(d=>s.add(+d)); return s; }
function offSet(k){ const s=restSet(k); Object.keys(lvOf(k)).forEach(d=>s.add(+d)); return s; }
const restCount=k=>restSet(k).size, desCount=k=>Object.keys(desOf(k)).length, lvCount=k=>Object.keys(lvOf(k)).length;
function holidayOff(k){ let n=0; offSet(k).forEach(d=>{ if(isHoliday(d)) n++; }); return n; }
function rosterOf(k){ return CONFIG.roster.find(x=>sanitize(x.zh)===k); }
function noDesLimit(k){ const p=rosterOf(k); return !!(p&&p.nolimit); }
function desMaxOf(k){ return noDesLimit(k)?cfg.quota:cfg.desigMax; }

function setOff(k,d,v){ if(!off[k])off[k]={}; if(v)off[k][d]=true; else delete off[k][d]; if(cloudReady()) dref('off/'+k+'/'+d).set(v?true:null); }
function setDes(k,d,v){ if(!desig[k])desig[k]={}; if(v)desig[k][d]=true; else delete desig[k][d]; if(cloudReady()) dref('desig/'+k+'/'+d).set(v?true:null); }
function setLv(k,d,v){ if(!leave[k])leave[k]={}; if(v)leave[k][d]=v; else delete leave[k][d]; if(cloudReady()) dref('leave/'+k+'/'+d).set(v||null); }
function clearDay(k,d){ setOff(k,d,false); setDes(k,d,false); setLv(k,d,null); }

function setDay(d,target,label){
  const k=myKey(), cap=capOf(k);
  const inOff=!!offOf(k)[d], inDes=!!desOf(k)[d], inLv=lvOf(k)[d]!=null;
  const wasRest=inOff||inDes, wasOffAny=inOff||inDes||inLv;
  const holFullForNew = isHoliday(d) && !wasOffAny && cap>0 && holidayOff(k)>=cap;
  if(target==='off'||target==='des'){
    if(!wasRest && restCount(k)>=cfg.quota){ toast('已達 '+cfg.quota+' 天上限'); return false; }
    if(holFullForNew){ toast('假日已達 '+cap+' 天上限'); return false; }
    if(target==='des' && !inDes){ const dm=desMaxOf(k); if(dm>0 && desCount(k)>=dm){ toast('指定休最多 '+dm+' 天'); return false; } }
    clearDay(k,d); if(target==='off') setOff(k,d,true); else setDes(k,d,true);
  }else if(target==='lv'){
    if(holFullForNew){ toast('假日已達 '+cap+' 天上限'); return false; }
    clearDay(k,d); setLv(k,d,label||'A');
  }else { clearDay(k,d); }
  renderAll(); return true;
}
function clearMine(){ if(!me) return; const k=myKey(); off[k]={};desig[k]={};leave[k]={}; if(cloudReady()){ dref('off/'+k).set(null);dref('desig/'+k).set(null);dref('leave/'+k).set(null); } renderAll(); toast('已清除'); }
function saveNote(v){ if(!me) return; notes[myKey()]=v; if(cloudReady()) dref('notes/'+myKey()).set(v||null); }

/* 底部面板 */
function cellState(k,d){ return desOf(k)[d]?'des':offOf(k)[d]?'off':(lvOf(k)[d]!=null?'lv':'none'); }
function openSheet(d){
  sheetDay=d; const k=myKey(), cur=lvOf(k)[d];
  sheetHours = (cur!=null&&cur!=='A') ? (parseInt((cur.match(/(\d+)/)||[])[1],10)||8) : 8;
  renderSheet(); $('sheetBg').classList.add('show'); $('sheet').classList.add('show');
}
function closeSheet(){ $('sheetBg').classList.remove('show'); $('sheet').classList.remove('show'); sheetDay=null; }
function renderSheet(){
  const d=sheetDay, k=myKey(), s=cellState(k,d);
  const lvType=(s==='lv')?(lvOf(k)[d]||'A').replace(/\d+/g,''):'';
  $('sheetDate').textContent = cfg.month+'/'+d+'（'+weekday(d)+'）'+(isHoliday(d)?'・假日':'');
  const b=(lbl,on,attr)=>'<button class="sbtn'+(on?' on':'')+'" '+attr+'>'+lbl+'</button>';
  let h='<div class="srow">'+b('一般休 DO',s==='off','data-set="off"')+b('指定休',s==='des','data-set="des"')+'</div>';
  h+='<div class="sub2">假別（點類別即套用）　時數 <span class="step"><b data-step="-1">−</b><i id="shH">'+sheetHours+'</i><b data-step="1">＋</b></span></div>';
  h+='<div class="srow">'+['年','補','喪','他'].map(t=>b(LVNAME[t], s==='lv'&&lvType===t, 'data-lv="'+t+'"')).join('')+'</div>';
  h+='<div class="srow"><button class="sbtn danger" data-set="none">清除這天</button></div>';
  $('sheetOpts').innerHTML=h;
  $('sheetOpts').querySelectorAll('[data-set]').forEach(x=>x.addEventListener('click',()=>{ if(setDay(sheetDay,x.dataset.set)) closeSheet(); }));
  $('sheetOpts').querySelectorAll('[data-lv]').forEach(x=>x.addEventListener('click',()=>{ if(setDay(sheetDay,'lv', x.dataset.lv+sheetHours)) closeSheet(); }));
  $('sheetOpts').querySelectorAll('[data-step]').forEach(x=>x.addEventListener('click',()=>{ sheetHours=Math.min(12,Math.max(1,sheetHours+(+x.dataset.step))); $('shH').textContent=sheetHours; }));
}

/* 畫休日曆 */
function calCells(k, ro){
  let html=''; WD.forEach((w,i)=>html+='<div class="wk'+((i===0||i===6)?' we':'')+'">'+w+'</div>');
  for(let i=0;i<firstDow();i++) html+='<div class="cell blank"></div>';
  const de=desOf(k), of=offOf(k), lv=lvOf(k), N=dim();
  for(let d=1;d<=N;d++){
    const cls=['cell']; if(ro)cls.push('ro'); let mk='',lb='';
    if(isWeekend(d)) cls.push('we');
    if(de[d]){ cls.push('des'); mk='<span class="mk">指定</span>'; }
    else if(of[d]){ cls.push('off'); mk='<span class="mk">'+CONFIG.offMark+'</span>'; }
    else if(lv[d]!=null){ cls.push('lv'); mk='<span class="mk">A</span>'; if(lv[d]!=='A') lb='<div class="lb">'+esc(lv[d])+'</div>'; }
    if(ro && (de[d]||of[d]||lv[d]!=null)) cls.push('ghost');
    const hl=holLabel(d); const hol=(!de[d]&&!of[d]&&lv[d]==null&&hl)?'<div class="hol">'+esc(hl)+'</div>':'';
    html+='<div class="'+cls.join(' ')+'" data-d="'+d+'"><div class="d">'+d+'</div>'+hol+lb+mk+'</div>';
  }
  return html;
}
function renderCal(){
  $('cal').innerHTML=calCells(myKey(), false);
  $('cal').querySelectorAll('.cell[data-d]').forEach(el=>el.addEventListener('click',()=>{
    if(!me){ toast('請先在上方選擇你的名字'); return; }
    const d=+el.dataset.d, k=myKey();
    if(cellState(k,d)!=='none'){ openSheet(d); return; }
    const cap=capOf(k), holiday=isHoliday(d);
    const holFull = holiday && cap>0 && holidayOff(k)>=cap;
    const restFull = restCount(k)>=cfg.quota;
    if(!restFull && !holFull) setDay(d,'off');           // 直接畫休
    else if(!holFull) openSheet(d);                      // 額度滿但仍可選假別
    else toast(holiday?('假日已達 '+cap+' 天上限'):('已達 '+cfg.quota+' 天上限'));
  }));
}
function renderQuota(){
  const k=myKey(), nf=$('noteField'); if(document.activeElement!==nf) nf.value=me?(notes[k]||''):'';
  if(!me){ $('qHead').textContent='請先在上方選擇你的名字'; $('qFill').style.width='0%'; $('qChips').innerHTML=''; $('quota').classList.remove('overq'); return; }
  const rc=restCount(k), left=cfg.quota-rc, dz=desCount(k), hoff=holidayOff(k), cap=capOf(k), wz=lvCount(k), hOver=cap>0&&hoff>cap;
  $('qHead').textContent = left>0 ? ('還要畫 '+left+' 天') : left===0 ? ('✓ 已畫滿 '+cfg.quota+' 天') : ('超過 '+(-left)+' 天，請減少');
  const f=$('qFill'); f.style.width=Math.min(1,rc/Math.max(1,cfg.quota))*100+'%'; f.classList.toggle('over',left<0);
  let chips='<span class="qchip'+((!noDesLimit(k)&&dz>cfg.desigMax)?' bad':'')+'">指定 '+dz+(noDesLimit(k)?'（不限）':'/'+cfg.desigMax)+'</span><span class="qchip'+(hOver?' bad':'')+'">假日 '+hoff+'/'+cap+'</span>';
  if(wz>0) chips+='<span class="qchip">假別 '+wz+'</span>';
  $('qChips').innerHTML=chips; $('quota').classList.toggle('overq', left<0||hOver);
}

/* 總表 */
function renderBoard(){
  const N=dim(), dayCount=new Array(N+1).fill(0);
  CONFIG.roster.forEach(p=>{ offSet(sanitize(p.zh)).forEach(d=>{ if(d>=1&&d<=N) dayCount[d]++; }); });
  const under=[],over=[],hOver=[],desMiss=[];
  CONFIG.roster.forEach(p=>{ const k=sanitize(p.zh), rc=restCount(k);
    if(rc>0&&rc<cfg.quota) under.push(p.zh+'('+rc+')'); else if(rc>cfg.quota) over.push(p.zh+'('+rc+')');
    const h=holidayOff(k),hc=capOf(k); if(hc>0&&h>hc) hOver.push(p.zh+'(假日'+h+'/'+hc+')');
    if(rc>0&&!p.nolimit&&desCount(k)<cfg.desigMax) desMiss.push(p.zh+'('+desCount(k)+')');
  });
  let w='';
  if(hOver.length) w+='<div class="warnbox bad"><b>假日超過上限</b><br>'+hOver.join('、')+'</div>';
  if(over.length) w+='<div class="warnbox warn"><b>超過額度</b>　'+over.join('、')+'</div>';
  if(under.length) w+='<div class="warnbox warn"><b>尚未畫滿 '+cfg.quota+' 天</b><br>'+under.join('、')+'</div>';
  if(desMiss.length) w+='<div class="warnbox warn"><b>指定休未滿 '+cfg.desigMax+' 天</b><br>'+desMiss.join('、')+'</div>';
  if(!w) w='<div class="warnbox clear"><b>目前無異常</b></div>';
  let grid=''; WD.forEach(x=>grid+='<div class="dc blank"><div class="dn">'+x+'</div></div>');
  for(let i=0;i<firstDow();i++) grid+='<div class="dc blank"></div>';
  for(let d=1;d<=N;d++) grid+='<div class="dc"><div class="dn">'+d+'</div><div class="cn">'+dayCount[d]+'</div></div>';
  let np=''; CONFIG.roster.forEach(p=>{ const t=notes[sanitize(p.zh)]; if(t&&t.trim()) np+='<div class="prow"><div class="nn">'+esc(p.zh)+' '+esc(p.en)+'</div><div class="note">'+esc(t)+'</div></div>'; });
  $('panel-board').innerHTML=w+'<div class="notes-h" style="margin-top:6px">每日休假人數（含假別）</div><div class="daycount">'+grid+'</div>'+(np?('<div class="notes-h">特殊需求</div>'+np):'');
}

/* 匯出 */
function cellMark(k,d){ if(desOf(k)[d]) return CONFIG.desigMark; if(offOf(k)[d]) return CONFIG.offMark; const l=lvOf(k)[d]; if(l!=null) return (l==='A')?'A':('A'+l); return ''; }
function offOnDay(d){ let c=0; CONFIG.roster.forEach(p=>{ if(offSet(sanitize(p.zh)).has(d)) c++; }); return c; }
function buildMatrix(){
  const N=dim(), head=['姓名','C-Name']; for(let d=1;d<=N;d++) head.push(String(d)); head.push('特殊需求');
  const rows=[head];
  CONFIG.roster.forEach(p=>{ const k=sanitize(p.zh), r=[p.zh,p.en]; for(let d=1;d<=N;d++) r.push(cellMark(k,d)); r.push((notes[k]||'').replace(/\n/g,' ')); rows.push(r); });
  const t1=['休假人數','']; for(let d=1;d<=N;d++) t1.push(offOnDay(d)); t1.push('');
  const t2=['可排人力','']; for(let d=1;d<=N;d++) t2.push(CONFIG.roster.length-offOnDay(d)); t2.push('');
  rows.push(t1); rows.push(t2);
  return rows;
}
function buildTable(){
  const N=dim(), R=CONFIG.roster;
  const bd='border:1px solid #c8ced6;';
  const td=(t,s)=>'<td style="'+bd+'padding:3px 6px;text-align:center;white-space:nowrap;'+(s||'')+'">'+(t===''?'&nbsp;':t)+'</td>';
  const th=(t,s,sp)=>'<th '+(sp||'')+' style="'+bd+'padding:3px 6px;background:#eef1f4;'+(s||'')+'">'+t+'</th>';
  let h='<table border="1" style="border-collapse:collapse;font-family:sans-serif;font-size:12px">';
  // 表頭：日期
  h+='<tr>'+th('姓名','text-align:left','rowspan="2"')+th('C-Name','text-align:left','rowspan="2"');
  for(let d=1;d<=N;d++){ const ho=isHoliday(d); h+=th(String(d), ho?'background:#fde3d8;color:#b23c17':''); }
  h+=th('特殊需求','text-align:left','rowspan="2"')+'</tr>';
  // 表頭：星期
  h+='<tr>'; for(let d=1;d<=N;d++){ const ho=isHoliday(d); h+=th(weekday(d), 'font-weight:normal;'+(ho?'background:#fde3d8;color:#b23c17':'')); } h+='</tr>';
  // 各人
  R.forEach(p=>{ const k=sanitize(p.zh);
    h+='<tr>'+td(esc(p.zh),'text-align:left')+td(esc(p.en),'text-align:left');
    for(let d=1;d<=N;d++){
      let t='',s='';
      if(desOf(k)[d]){ t='DO'; s='background:#c6ebc9;color:#15803d;font-weight:bold'; }
      else if(offOf(k)[d]){ t='DO'; s='background:#e8f3f2;color:#2f6f6a'; }
      else if(lvOf(k)[d]!=null){ const l=lvOf(k)[d]; t=(l==='A')?'A':('A'+esc(l)); s='background:#fdeccf;color:#b45309;font-weight:bold'; }
      else if(isHoliday(d)){ s='background:#fdf2ec'; }
      h+=td(t,s);
    }
    h+=td(esc((notes[k]||'').replace(/\n/g,' ')),'text-align:left')+'</tr>';
  });
  // 統計列
  const gs='background:#eef1f4;font-weight:bold;', ws='background:#eaf3f1;font-weight:bold;color:#255a56;';
  h+='<tr>'+td('休假人數','text-align:left;'+gs)+td('',gs); for(let d=1;d<=N;d++) h+=td(offOnDay(d),gs); h+=td('',gs)+'</tr>';
  h+='<tr>'+td('可排人力','text-align:left;'+ws)+td('',ws); for(let d=1;d<=N;d++) h+=td(R.length-offOnDay(d),ws); h+=td('',ws)+'</tr>';
  h+='</table>';
  return h;
}
const toTSV=r=>r.map(x=>x.join('\t')).join('\n');
function renderExport(){ $('exTable').innerHTML=buildTable(); }
function copyExport(){ const t=toTSV(buildMatrix()),done=()=>toast('已複製純文字，可貼進 Excel'); if(navigator.clipboard&&navigator.clipboard.writeText) navigator.clipboard.writeText(t).then(done).catch(()=>fb(t,done)); else fb(t,done); }
function fb(t,done){ const ta=document.createElement('textarea'); ta.value=t; ta.style.position='fixed'; ta.style.opacity='0'; document.body.appendChild(ta); ta.select(); try{document.execCommand('copy');done();}catch(e){toast('複製失敗');} document.body.removeChild(ta); }
function downloadXls(){
  const doc='<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel"><head><meta charset="utf-8"></head><body>'+buildTable()+'</body></html>';
  const b=new Blob(['\ufeff'+doc],{type:'application/vnd.ms-excel'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(b); a.download='預排班_'+periodKey()+'.xls'; document.body.appendChild(a); a.click(); document.body.removeChild(a); toast('已下載 Excel');
}

/* 管理 */
function cfgSet(field,val){ cfg[field]=val; if(cloudReady()) cref(field).set(val); }
function onPeriodChange(){ const np=periodKey(); if(np!==period){ period=np; if(cloudReady()) subscribeData(period); } renderAll(); }
function holToggle(d){ if(cfg.holidays[d]){ delete cfg.holidays[d]; if(cloudReady()) cref('holidays/'+d).set(null); } else { cfg.holidays[d]=true; if(cloudReady()) cref('holidays/'+d).set(true); } renderAll(); }
function saveCap(v){ const k=sanitize(adminName); if(!k) return; const n=Math.max(0,parseInt(v||'0',10)||0); hcap[k]=n; if(cloudReady()) dref('hcap/'+k).set(n); renderAll(); }
function bulkCap(){ const v=prompt('把所有人的假日上限一次設為（天）：',String(cfg.holidayCap)); if(v==null) return; const n=Math.max(0,parseInt(v,10)||0); CONFIG.roster.forEach(p=>{ const k=sanitize(p.zh); hcap[k]=n; if(cloudReady()) dref('hcap/'+k).set(n); }); renderAll(); toast('已設所有人上限 '+n+' 天'); }
function renderAdmin(){
  if(!isAdmin()){ $('admLocked').style.display='block'; $('admOpen').style.display='none'; return; }
  $('admLocked').style.display='none'; $('admOpen').style.display='block';
  const set=(id,v)=>{ const e=$(id); if(document.activeElement!==e) e.value=v; };
  set('cfgY',cfg.year); set('cfgM',cfg.month); set('cfgQ',cfg.quota); set('cfgD',cfg.desigMax); set('cfgH',cfg.holidayCap);
  let html=''; WD.forEach((w,i)=>html+='<div class="wk'+((i===0||i===6)?' we':'')+'">'+w+'</div>');
  for(let i=0;i<firstDow();i++) html+='<div class="cell blank"></div>';
  const N=dim();
  for(let d=1;d<=N;d++){ const cls=['cell']; if(isWeekend(d))cls.push('we'); const on=!!cfg.holidays[d]; if(on)cls.push('hol-on'); const lb=holLabel(d); html+='<div class="'+cls.join(' ')+'" data-hd="'+d+'"><div class="d">'+d+'</div>'+(on?'<div class="hol">'+(lb||'假')+'</div>':'')+'</div>'; }
  $('holCal').innerHTML=html;
  $('holCal').querySelectorAll('.cell[data-hd]').forEach(el=>el.addEventListener('click',()=>holToggle(+el.dataset.hd)));
  const k=sanitize(adminName), cin=$('admCap'); if(document.activeElement!==cin) cin.value=k?capOf(k):cfg.holidayCap;
  let setC=0; CONFIG.roster.forEach(p=>{ if(hcap[sanitize(p.zh)]!=null) setC++; });
  $('admProg').textContent=(k?('對象：預排 '+restCount(k)+'/'+cfg.quota+'・假日 '+holidayOff(k)+'/'+capOf(k)+'　·　'):'')+'已設個別上限 '+setC+'/'+CONFIG.roster.length;
}

/* 共用 */
function esc(s){ return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
let tH=null; function toast(t){ const el=$('toast'); el.textContent=t; el.classList.add('show'); clearTimeout(tH); tH=setTimeout(()=>el.classList.remove('show'),1900); }
function renderAll(){ $('title').textContent=CONFIG.title+'（'+cfg.year+'/'+cfg.month+'）'; renderCal(); renderQuota(); renderBoard(); renderExport(); renderAdmin(); }

function boot(){
  $('periodLabel').textContent='請於期限前完成畫休';
  $('foot').textContent='資料節點：'+CONFIG.appRoot+'　·　名字記錄在本機，換人請重選';
  const optZh=p=>'<option value="'+esc(p.zh)+'">'+esc(p.zh)+'　'+esc(p.en)+'</option>';
  $('nameField').innerHTML='<option value="">請選擇姓名</option>'+CONFIG.roster.map(p=>'<option value="'+esc(p.zh)+'"'+(p.zh===me?' selected':'')+'>'+esc(p.zh)+'　'+esc(p.en)+'</option>').join('');
  $('nameField').addEventListener('change',e=>{ me=e.target.value; localStorage.setItem('sched_zh',me); renderAll(); });
  $('admName').innerHTML='<option value="">請選擇</option>'+CONFIG.roster.map(optZh).join('');
  $('admName').addEventListener('change',e=>{ adminName=e.target.value; renderAdmin(); });
  document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>{ document.querySelectorAll('.tab').forEach(x=>x.classList.remove('on')); document.querySelectorAll('.panel').forEach(x=>x.classList.remove('on')); t.classList.add('on'); $('panel-'+t.dataset.tab).classList.add('on'); }));
  $('clearMine').addEventListener('click',clearMine);
  $('noteField').addEventListener('input',e=>{ clearTimeout(noteTimer); const v=e.target.value; noteTimer=setTimeout(()=>saveNote(v),500); });
  $('btnCopy').addEventListener('click',copyExport); $('btnXls').addEventListener('click',downloadXls);
  $('sheetBg').addEventListener('click',closeSheet);
  $('admUnlock').addEventListener('click',()=>{ const p=prompt('請輸入管理密碼'); if(p===CONFIG.adminPassword){ sessionStorage.setItem('sched_admin','1'); renderAdmin(); toast('已解鎖管理'); } else if(p!=null) toast('密碼錯誤'); });
  $('admLock').addEventListener('click',()=>{ sessionStorage.removeItem('sched_admin'); renderAdmin(); toast('已鎖定'); });
  $('cfgY').addEventListener('change',e=>{ cfgSet('year',parseInt(e.target.value,10)||cfg.year); onPeriodChange(); });
  $('cfgM').addEventListener('change',e=>{ cfgSet('month',parseInt(e.target.value,10)||cfg.month); onPeriodChange(); });
  $('cfgQ').addEventListener('change',e=>{ cfgSet('quota',parseInt(e.target.value,10)||0); renderAll(); });
  $('cfgD').addEventListener('change',e=>{ cfgSet('desigMax',parseInt(e.target.value,10)||0); renderAll(); });
  $('cfgH').addEventListener('change',e=>{ cfgSet('holidayCap',parseInt(e.target.value,10)||0); renderAll(); });
  $('admCap').addEventListener('change',e=>saveCap(e.target.value));
  $('admBulkCap').addEventListener('click',bulkCap);
  period=periodKey(); renderAll(); initFirebase();
}
document.addEventListener('DOMContentLoaded',boot);
</script>
</body>
</html>
